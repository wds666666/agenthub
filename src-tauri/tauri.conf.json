{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentHub",
  "version": "0.1.1",
  "identifier": "dev.agenthub.desktop",
  "build": { "beforeDevCommand": "pnpm dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "pnpm build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "AgentHub", "width": 1280, "height": 800, "minWidth": 760, "minHeight": 600 }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" } },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "AgentHub",
    "shortDescription": "Local-first agent capability manager",
    "longDescription": "Manage and synchronize user-global Skills, MCP servers, Plugins and Rules across supported AI coding tools.",
    "copyright": "Copyright © 2026 AgentHub contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
