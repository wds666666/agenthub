{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis", "msi"],
    "externalBin": ["binaries/agenthub"],
    "resources": {
      "../skills/agenthub-manager/": "skills/agenthub-manager/",
      "../scripts/windows-cli.ps1": "windows-cli.ps1",
      "binaries/windows-resources.json": "windows-resources.json"
    },
    "useLocalToolsDir": true,
    "windows": {
      "allowDowngrades": false,
      "bundleVCRuntime": true,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installerHooks": "windows/hooks.nsh",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "AgentHub"
      },
      "wix": {
        "fragmentPaths": ["windows/cli.wxs"],
        "componentGroupRefs": ["AgentHubCommandIntegration"]
      }
    }
  }
}
